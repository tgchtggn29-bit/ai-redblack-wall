[Unit]
Description=AI Redblack Vote Wall
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/vote
Environment=PORT=3000
Environment=TRUST_PROXY=1
Environment=OWNER_TOKEN=__OWNER_TOKEN__
ExecStart=/usr/local/bin/node /var/www/vote/server.js
Restart=always
RestartSec=3
User=root
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
